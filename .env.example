# ─────────────────────────────────────────────────────────────
# SAINT — Environment Configuration
# Copy this file to .env and fill in the values you need.
# saint demo works without any changes here.
# ─────────────────────────────────────────────────────────────

APP_NAME=Saint
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=WARNING

FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ─── LLM ─────────────────────────────────────────────────────
# saint demo works without an LLM key (uses structural fallback).
# For full output quality, set one of:
#
#   Groq (free tier at console.groq.com — recommended):
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
#
#   Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# LLM_MODEL=gemini-2.0-flash

# ─── DataHub ─────────────────────────────────────────────────
# Default: mock — saint demo uses this, no DataHub needed.
DATAHUB_PROVIDER=mock

# For connected mode (requires: pip install "saint[agent-context]"):
# DATAHUB_PROVIDER=agent_context
# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_GMS_TOKEN=<personal-access-token>

DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=